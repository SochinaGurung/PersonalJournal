@page "/dashboard"
@inject NavigationManager Navigation
@inject Coursework.Services.DatabaseService DatabaseService
@inject Coursework.Services.AuthenticationService AuthService


<div class="dashboard-layout">

    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="user-profile">
            <!-- <img src="https://via.placeholder.com/48" alt="User" /> -->
            <div>
                <h3>📖MyJournal </h3>
            </div>
        </div>

        <nav class="menu">
            <NavLink href="/dashboard" class="nav-link" Match="NavLinkMatch.All">
                <i class="bi bi-grid"></i>
                <span>Dashboard</span>
            </NavLink>

            <NavLink href="/journal" class="nav-link">
                <i class="bi bi-plus-square"></i>
                <span>New Entry</span>
            </NavLink>

            <NavLink href="/calendar" class="nav-link">
                <i class="bi bi-calendar3"></i>
                <span>Calendar</span>
            </NavLink>

            <NavLink href="/journal-list" class="nav-link">
                <i class="bi bi-journal-text"></i>
                <span>Journal List</span>
            </NavLink>

            <NavLink href="/settings" class="nav-link">
                <i class="bi bi-gear"></i>
                <span>Settings</span>
            </NavLink>
        </nav>

        <button class="logout-btn" @onclick="Logout">
            <i class="bi bi-box-arrow-right"></i> Logout
        </button>
        <p class="version">Made with <i class="bi bi-heart-fill"></i></p>
    </aside>

    <!-- Main Content -->
    <main class="main-content">

        <!-- Header -->
        <header class="top-header">
            <div class="header-left">
                <h2 class="header-sub">
                    Good @(DateTime.Now.Hour < 12 ? "morning" : "evening"), @UserName. Ready for growth?
                </h2>
                <span class="header-date">
                    @DateTime.Now.ToString("dddd, MMM dd").ToUpper()
                </span>
            </div>

            <div class="avatar">
                <img src="images/user.png" alt="User Avatar" />
            </div>
        </header>


        <!-- Stats -->
        <section class="stats">
            <div class="stat-card">
                <span class="icon"><i class="bi bi-fire"></i></span>
                <p class="label">Streak</p>
                <h2>@StreakDays Days</h2>
                <small>@(StreakDays > 0 ? "You're on fire!" : "Start your streak!")</small>
            </div>

            <div class="stat-card">
                <span class="icon"><i class="bi bi-trophy"></i></span>
                <p class="label">Record</p>
                <h2>@LongestStreak Days</h2>
                <small>@(LongestStreak > 0 ? "Keep pushing!" : "Set your record!")</small>
            </div>

            <div class="stat-card">
                <span class="icon"><i class="bi bi-journal-text"></i></span>
                <p class="label">Total Entries</p>
                <h2>@TotalEntries</h2>
                <small>@(TotalEntries > 0 ? "Great progress!" : "Start journaling!")</small>
            </div>
        </section>

        <!-- Analytics -->
        <section class="analytics">
            <div class="card">
                <div class="card-header">
                    <h3><i class="bi bi-pie-chart"></i> Mood Distribution</h3>
                </div>
                
                @if (MoodDistribution.Count > 0)
                {
                    var totalMoodEntries = MoodDistribution.Values.Sum();
                    var sortedMoods = MoodDistribution.OrderByDescending(m => m.Value).ToList();
                    var dominantMood = sortedMoods.First();
                    
                    <div class="mood-chart-container">
                        <!-- Donut Chart -->
                        <div class="donut-chart-wrapper">
                            <svg class="donut-chart" viewBox="0 0 200 200">
                                @{
                                    double radius = 70;
                                    double circumference = 2 * Math.PI * radius;
                                    double accumulatedLength = 0;
                                }
                                @foreach (var mood in sortedMoods)
                                {
                                    var percentage = totalMoodEntries > 0 ? (mood.Value * 100.0 / totalMoodEntries) : 0;
                                    var segmentLength = (percentage / 100.0) * circumference;
                                    var gapLength = circumference - segmentLength;
                                    var offset = circumference - accumulatedLength;
                                    
                                    <circle cx="100" cy="100" r="@radius.ToString("F0")" 
                                            fill="none" 
                                            stroke="@GetMoodColor(mood.Key)" 
                                            stroke-width="40"
                                            stroke-dasharray="@segmentLength.ToString("F2") @gapLength.ToString("F2")"
                                            stroke-dashoffset="@offset.ToString("F2")"
                                            transform="rotate(-90 100 100)"
                                            class="donut-segment" />
                                    
                                    accumulatedLength += segmentLength;
                                }
                            </svg>
                            <div class="donut-center">
                                <div class="donut-emoji">@((MarkupString)GetMoodEmoji(dominantMood.Key))</div>
                                <div class="donut-label">MOSTLY</div>
                            </div>
                        </div>
                        
                        <!-- Legend -->
                        <div class="mood-legend">
                            @foreach (var mood in sortedMoods)
                            {
                                var percentage = totalMoodEntries > 0 ? (mood.Value * 100.0 / totalMoodEntries) : 0;
                                <div class="legend-item">
                                    <span class="legend-dot" style="background-color: @GetMoodColor(mood.Key);"></span>
                                    <span class="legend-label">@GetMoodDisplayName(mood.Key)</span>
                                    <span class="legend-percentage">@percentage.ToString("F0")%</span>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="no-data">
                        <p>No mood data yet. Start journaling to see your mood distribution!</p>
                    </div>
                }
            </div>

            <div class="card">
                <div class="card-header">
                    <h3><i class="bi bi-star-fill"></i> Most Frequent Moods</h3>
                    <p class="sub">Last 30 Days</p>
                </div>
                @if (MoodDistribution.Count > 0)
                {
                    var sortedMoods = MoodDistribution.OrderByDescending(m => m.Value).Take(5).ToList();
                    var maxCount = sortedMoods.FirstOrDefault().Value;
                    
                    @foreach (var mood in sortedMoods)
                    {
                        var percentage = maxCount > 0 ? (mood.Value * 100.0 / maxCount) : 0;
                        <div style="margin-bottom: 12px;">
                            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px;">
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <span>@((MarkupString)GetMoodEmojiSmall(mood.Key))</span>
                                    <span style="font-weight: 500;">@GetMoodDisplayName(mood.Key)</span>
                                </div>
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <span style="font-size: 0.9rem; color: #666;">@mood.Value time@(mood.Value != 1 ? "s" : "")</span>
                                </div>
                            </div>
                            <div class="bar" style="width: @(percentage)%; background: @GetMoodColor(mood.Key); height: 6px; border-radius: 3px;"></div>
                        </div>
                    }
                }
                else
                {
                    <div class="no-data">
                        <p>No mood data yet. Start journaling to see your most frequent moods!</p>
                    </div>
                }
            </div>

            <div class="card">
                <h3>Top Tags</h3>
                @if (TopTags.Count > 0)
                {
                    var maxCount = TopTags.Values.Max();
                    @foreach (var tag in TopTags)
                    {
                        var percentage = maxCount > 0 ? (tag.Value * 100.0 / maxCount) : 0;
                        <div class="tag">
                            <span>#@tag.Key</span>
                            <span>@tag.Value entry@(tag.Value != 1 ? "ies" : "")</span>
                        </div>
                        <div class="bar" style="width: @(percentage)%; background: @GetTagColor(tag.Key);"></div>
                    }
                }
                else
                {
                    <p style="color: #999; font-size: 14px;">No tags yet. Add tags to your entries!</p>
                }
            </div>
            
            <div class="card">
                <h3>Tag Breakdown by Category</h3>
                <p class="sub">Tag usage per category</p>
                @if (TagBreakdown.Count > 0)
                {
                    var maxCount = TagBreakdown.Values.Max();
                    @foreach (var category in TagBreakdown.OrderByDescending(c => c.Value))
                    {
                        var percentage = maxCount > 0 ? (category.Value * 100.0 / maxCount) : 0;
                        <div style="margin-bottom: 8px;">
                            <div style="display: flex; justify-content: space-between; margin-bottom: 4px;">
                                <span>@category.Key</span>
                                <span>@category.Value tag@(category.Value != 1 ? "s" : "")</span>
                            </div>
                            <div class="bar" style="width: @(percentage)%; background: @GetTagColor(category.Key);"></div>
                        </div>
                    }
                }
                else
                {
                    <p style="color: #999; font-size: 14px;">No category data yet</p>
                }
            </div>
            
            @if (MissedDays.Count > 0)
            {
                <div class="card">
                    <h3>Missed Days</h3>
                    <p class="sub">Last 30 Days</p>
                    <p style="color: #ef4444; font-weight: bold;">@MissedDays.Count day@(MissedDays.Count != 1 ? "s" : "") missed</p>
                    <div style="max-height: 150px; overflow-y: auto; margin-top: 8px;">
                        @foreach (var missedDay in MissedDays.Take(10))
                        {
                            <div style="padding: 4px; font-size: 12px; color: #666;">
                                <i class="bi bi-calendar"></i> @missedDay.ToString("MMM dd, yyyy")
                            </div>
                        }
                        @if (MissedDays.Count > 10)
                        {
                            <p style="font-size: 12px; color: #999;">...and @(MissedDays.Count - 10) more</p>
                        }
                    </div>
                </div>
            }
        </section>

        <!-- Word Count -->
        <section class="card wide">
            <h3>Word Count Trends</h3>
            <p class="sub">Average: @AverageWordCount.ToString("F0") words per entry</p>

            <!-- Chart placeholder -->
            <div class="line-chart">
                <span><i class="bi bi-graph-up"></i> @TotalEntries entr@(TotalEntries != 1 ? "ies" : "") total</span>
            </div>
        </section>

    </main>
</div>
@code {
    private string UserName => AuthService.UserName;
    private int TotalEntries = 0;
    private int StreakDays = 0;
    private int LongestStreak = 0;
    private double AverageWordCount = 0;
    private Dictionary<string, int> MoodDistribution = new Dictionary<string, int>();
    private Dictionary<string, int> TopTags = new Dictionary<string, int>();
    private string MostFrequentMood = "";
    private Dictionary<string, int> TagBreakdown = new Dictionary<string, int>();
    private List<DateTime> MissedDays = new List<DateTime>();

    protected override void OnInitialized()
    {
        LoadDashboardData();
    }

    private void LoadDashboardData()
    {
        TotalEntries = DatabaseService.GetTotalJournalEntries();
        StreakDays = DatabaseService.GetStreakDays();
        LongestStreak = DatabaseService.GetLongestStreak();
        AverageWordCount = DatabaseService.GetAverageWordCount();
        MoodDistribution = DatabaseService.GetMoodDistribution(30);
        TopTags = DatabaseService.GetTopTags(5);
        MostFrequentMood = DatabaseService.GetMostFrequentMood(30);
        TagBreakdown = DatabaseService.GetTagBreakdownByCategory();
        MissedDays = DatabaseService.GetMissedDays(DateTime.Now.AddDays(-30), DateTime.Now);
    }

    private string GetMoodClass(string mood)
    {
        return mood.ToLower() switch
        {
            "positive" or "happy" => "happy",
            "neutral" => "neutral",
            "excited" => "excited",
            _ => "other"
        };
    }

    private string GetMoodColor(string mood)
    {
        return mood.ToLower() switch
        {
            "positive" or "happy" => "#16a085", 
            "neutral" => "#7c8db5",
            "negative" => "#b8a9c9", 
            "excited" => "#4cd964", 
            "calm" => "#5a9cff", 
            "tired" => "#b8a9c9", 
            _ => "#ddd" 
        };
    }

    private string GetMoodDisplayName(string mood)
    {
        return mood.ToLower() switch
        {
            "positive" => "Happy",
            "neutral" => "Calm",
            "negative" => "Tired",
            "excited" => "Excited",
            _ => mood
        };
    }

    private string GetTagColor(string tag)
    {
        var colors = new[] { "#ff4f7a", "#5a9cff", "#4cd964", "#9b5cff", "#ffc107" };
        var index = Math.Abs(tag.GetHashCode()) % colors.Length;
        return colors[index];
    }
    
    private string GetMoodEmoji(string mood)
    {
        return mood.ToLower() switch
        {
            "positive" or "happy" => "<i class=\"bi bi-emoji-smile\" style=\"font-size: 2rem;\"></i>",
            "neutral" or "calm" => "<i class=\"bi bi-emoji-neutral\" style=\"font-size: 2rem;\"></i>",
            "negative" or "tired" => "<i class=\"bi bi-emoji-frown\" style=\"font-size: 2rem;\"></i>",
            "excited" => "<i class=\"bi bi-emoji-smile\" style=\"font-size: 2rem;\"></i>",
            _ => "<i class=\"bi bi-journal-text\" style=\"font-size: 2rem;\"></i>"
        };
    }
    
    private string GetMoodEmojiSmall(string mood)
    {
        return mood.ToLower() switch
        {
            "positive" or "happy" => "<i class=\"bi bi-emoji-smile\" style=\"font-size: 1.2rem;\"></i>",
            "neutral" or "calm" => "<i class=\"bi bi-emoji-neutral\" style=\"font-size: 1.2rem;\"></i>",
            "negative" or "tired" => "<i class=\"bi bi-emoji-frown\" style=\"font-size: 1.2rem;\"></i>",
            "excited" => "<i class=\"bi bi-emoji-smile\" style=\"font-size: 1.2rem;\"></i>",
            _ => "<i class=\"bi bi-journal-text\" style=\"font-size: 1.2rem;\"></i>"
        };
    }
   
    private void GoToJournal()
    {
        Navigation.NavigateTo("/journal");
    }
    
    private void Logout()
    {
        AuthService.Logout();
        Navigation.NavigateTo("/");
    }
}
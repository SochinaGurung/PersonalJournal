@page "/dashboard"
@inject NavigationManager Navigation
@inject Coursework.Services.DatabaseService DatabaseService
@inject Coursework.Services.AuthenticationService AuthService


<div class="dashboard-layout">

    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="user-profile">
            <!-- <img src="https://via.placeholder.com/48" alt="User" /> -->
            <div>
                <h4>Hello, @UserName!</h4>
                <span class="plan">Free Plan Member</span>
            </div>
        </div>

        

        <nav class="menu">
            <NavLink href="/dashboard" class="nav-link" Match="NavLinkMatch.All">Dashboard</NavLink>
            <NavLink href="/calendar" class="nav-link">Calendar View</NavLink>
            <NavLink href="/journal-list" class="nav-link">Journal List</NavLink>
            <NavLink href="/settings" class="nav-link">Settings</NavLink>
        </nav>
        <button class="new-entry-btn" @onclick="GoToJournal">
            ＋ New Entry
        </button>
        <button class="logout-btn" @onclick="Logout">
            🚪 Logout
        </button>
        <p class="version">v1.2.0 · Made with 💗</p>
    </aside>

    <!-- Main Content -->
    <main class="main-content">

        <!-- Header -->
        <header class="top-header">
            <div>
                <h1>My Journal Dashboard</h1>
                <p>Your journaling insights at a glance 💗</p>
            </div>
            <span class="date">Today: @DateTime.Now.ToString("MMM dd, yyyy")</span>
        </header>

        <!-- Stats -->
        <section class="stats">
            <div class="stat-card">
                <span class="icon">🔥</span>
                <p class="label">Streak</p>
                <h2>@StreakDays Days</h2>
                <small>@(StreakDays > 0 ? "You're on fire!" : "Start your streak!")</small>
            </div>

            <div class="stat-card">
                <span class="icon">🏆</span>
                <p class="label">Record</p>
                <h2>@LongestStreak Days</h2>
                <small>@(LongestStreak > 0 ? "Keep pushing!" : "Set your record!")</small>
            </div>

            <div class="stat-card">
                <span class="icon">📝</span>
                <p class="label">Total Entries</p>
                <h2>@TotalEntries</h2>
                <small>@(TotalEntries > 0 ? "Great progress!" : "Start journaling!")</small>
            </div>
        </section>

        <!-- Analytics -->
        <section class="analytics">
            <div class="card">
                <h3>Mood Distribution</h3>
                <p class="sub">Last 30 Days</p>
                
                @if (!string.IsNullOrEmpty(MostFrequentMood) && MostFrequentMood != "None")
                {
                    <div style="margin-bottom: 12px; padding: 8px; background: #f0f0f0; border-radius: 4px;">
                        <strong>Most Frequent Mood:</strong> @MostFrequentMood @GetMoodEmoji(MostFrequentMood)
                    </div>
                }

                <!-- Placeholder for chart -->
                <div class="donut">
                    <span>Mostly @MostFrequentMood @GetMoodEmoji(MostFrequentMood)</span>
                </div>

                <ul class="legend">
                    @foreach (var mood in MoodDistribution)
                    {
                        var percentage = TotalEntries > 0 ? (mood.Value * 100.0 / TotalEntries) : 0;
                        <li>
                            <span class="@GetMoodClass(mood.Key)"></span> 
                            @mood.Key @percentage.ToString("F0")%
                        </li>
                    }
                    @if (MoodDistribution.Count == 0)
                    {
                        <li>No mood data yet</li>
                    }
                </ul>
            </div>

            <div class="card">
                <h3>Top Tags</h3>
                @if (TopTags.Count > 0)
                {
                    var maxCount = TopTags.Values.Max();
                    @foreach (var tag in TopTags)
                    {
                        var percentage = maxCount > 0 ? (tag.Value * 100.0 / maxCount) : 0;
                        <div class="tag">
                            <span>#@tag.Key</span>
                            <span>@tag.Value entry@(tag.Value != 1 ? "ies" : "")</span>
                        </div>
                        <div class="bar" style="width: @(percentage)%; background: @GetTagColor(tag.Key);"></div>
                    }
                }
                else
                {
                    <p style="color: #999; font-size: 14px;">No tags yet. Add tags to your entries!</p>
                }
            </div>
            
            <div class="card">
                <h3>Tag Breakdown by Category</h3>
                <p class="sub">Tag usage per category</p>
                @if (TagBreakdown.Count > 0)
                {
                    var maxCount = TagBreakdown.Values.Max();
                    @foreach (var category in TagBreakdown.OrderByDescending(c => c.Value))
                    {
                        var percentage = maxCount > 0 ? (category.Value * 100.0 / maxCount) : 0;
                        <div style="margin-bottom: 8px;">
                            <div style="display: flex; justify-content: space-between; margin-bottom: 4px;">
                                <span>@category.Key</span>
                                <span>@category.Value tag@(category.Value != 1 ? "s" : "")</span>
                            </div>
                            <div class="bar" style="width: @(percentage)%; background: @GetTagColor(category.Key);"></div>
                        </div>
                    }
                }
                else
                {
                    <p style="color: #999; font-size: 14px;">No category data yet</p>
                }
            </div>
            
            @if (MissedDays.Count > 0)
            {
                <div class="card">
                    <h3>Missed Days</h3>
                    <p class="sub">Last 30 Days</p>
                    <p style="color: #ef4444; font-weight: bold;">@MissedDays.Count day@(MissedDays.Count != 1 ? "s" : "") missed</p>
                    <div style="max-height: 150px; overflow-y: auto; margin-top: 8px;">
                        @foreach (var missedDay in MissedDays.Take(10))
                        {
                            <div style="padding: 4px; font-size: 12px; color: #666;">
                                📅 @missedDay.ToString("MMM dd, yyyy")
                            </div>
                        }
                        @if (MissedDays.Count > 10)
                        {
                            <p style="font-size: 12px; color: #999;">...and @(MissedDays.Count - 10) more</p>
                        }
                    </div>
                </div>
            }
        </section>

        <!-- Word Count -->
        <section class="card wide">
            <h3>Word Count Trends</h3>
            <p class="sub">Average: @AverageWordCount.ToString("F0") words per entry</p>

            <!-- Chart placeholder -->
            <div class="line-chart">
                <span>📈 @TotalEntries entry@(TotalEntries != 1 ? "ies" : "") total</span>
            </div>
        </section>

    </main>
</div>
@code {
    private string UserName => AuthService.UserName;
    private int TotalEntries = 0;
    private int StreakDays = 0;
    private int LongestStreak = 0;
    private double AverageWordCount = 0;
    private Dictionary<string, int> MoodDistribution = new Dictionary<string, int>();
    private Dictionary<string, int> TopTags = new Dictionary<string, int>();
    private string MostFrequentMood = "";
    private Dictionary<string, int> TagBreakdown = new Dictionary<string, int>();
    private List<DateTime> MissedDays = new List<DateTime>();

    protected override void OnInitialized()
    {
        LoadDashboardData();
    }

    private void LoadDashboardData()
    {
        TotalEntries = DatabaseService.GetTotalJournalEntries();
        StreakDays = DatabaseService.GetStreakDays();
        LongestStreak = DatabaseService.GetLongestStreak();
        AverageWordCount = DatabaseService.GetAverageWordCount();
        MoodDistribution = DatabaseService.GetMoodDistribution(30);
        TopTags = DatabaseService.GetTopTags(5);
        MostFrequentMood = DatabaseService.GetMostFrequentMood(30);
        TagBreakdown = DatabaseService.GetTagBreakdownByCategory();
        MissedDays = DatabaseService.GetMissedDays(DateTime.Now.AddDays(-30), DateTime.Now);
    }

    private string GetMoodClass(string mood)
    {
        return mood.ToLower() switch
        {
            "positive" or "happy" => "happy",
            "neutral" => "neutral",
            "excited" => "excited",
            _ => "other"
        };
    }

    private string GetTagColor(string tag)
    {
        var colors = new[] { "#ff4f7a", "#5a9cff", "#4cd964", "#9b5cff", "#ffc107" };
        var index = Math.Abs(tag.GetHashCode()) % colors.Length;
        return colors[index];
    }
    
    private string GetMoodEmoji(string mood)
    {
        return mood.ToLower() switch
        {
            "positive" => "😊",
            "neutral" => "😐",
            "negative" => "😔",
            _ => "📝"
        };
    }
   
    private void GoToJournal()
    {
        Navigation.NavigateTo("/journal");
    }
    
    private void Logout()
    {
        AuthService.Logout();
        Navigation.NavigateTo("/");
    }
}
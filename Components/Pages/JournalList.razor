@page "/journal-list"
@inject Coursework.Services.DatabaseService DatabaseService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="journal-list-page">
    <header class="page-header">
        <div>
            <button class="back-dashboard-btn" @onclick="GoToDashboard"><i class="bi bi-arrow-left"></i> Back to Dashboard</button>
            <h1>My Journal Entries</h1>
            <p>All your journal entries in one place <i class="bi bi-heart-fill"></i></p>
        </div>
        <button class="new-entry-btn" @onclick="GoToNewJournal"><i class="bi bi-plus-circle"></i> New Entry</button>
    </header>

    <!-- Filters -->
    @if (JournalEntries.Count > 0)
    {
        <div class="filters-bar">
            <select class="filter-select" value="@SelectedDateFilter" @onchange="@((ChangeEventArgs e) => { SelectedDateFilter = e.Value?.ToString() ?? ""; ApplyFilters(); })">
                <option value="">All Dates</option>
                <option value="today">Today</option>
                <option value="week">This Week</option>
                <option value="month">This Month</option>
            </select>
            <select class="filter-select" value="@SelectedMoodFilter" @onchange="@((ChangeEventArgs e) => { SelectedMoodFilter = e.Value?.ToString() ?? ""; ApplyFilters(); })">
                <option value="">Select Mood</option>
                <option value="Positive">Positive</option>
                <option value="Neutral">Neutral</option>
                <option value="Negative">Negative</option>
            </select>
            <select class="filter-select" value="@SelectedTagFilter" @onchange="@((ChangeEventArgs e) => { SelectedTagFilter = e.Value?.ToString() ?? ""; ApplyFilters(); })">
                <option value="">Popular Tags</option>
                @foreach (var tag in PopularTags)
                {
                    <option value="@tag">@tag</option>
                }
            </select>
        </div>
    }

    @if (FilteredEntries.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon"><i class="bi bi-journal-text" style="font-size: 4rem;"></i></div>
            <h2>No entries yet</h2>
            <p>Start your journaling journey by creating your first entry!</p>
            <button class="new-entry-btn" @onclick="GoToNewJournal">Create First Entry</button>
        </div>
    }
    else
    {
        <div class="entries-list">
            @foreach (var entry in PaginatedEntries)
            {
                <div class="entry-item" @onclick="() => EditEntry(entry.Id)">
                    <div class="entry-mood-icon">
                        @((MarkupString)GetMoodEmojiIcon(entry.PrimaryMood))
                    </div>
                    <div class="entry-main">
                        <h3>@entry.Title</h3>
                        <p class="entry-preview">@GetPreview(entry.Content)</p>
                    </div>
                    <div class="entry-right">
                        <span class="entry-date">@entry.CreatedAt.ToString("MMM dd, yyyy")</span>
                        <i class="bi bi-chevron-right entry-arrow"></i>
                    </div>
                </div>
            }
        </div>
        
        <!-- Pagination with Page Numbers -->
        @if (TotalPages > 1)
        {
            <div class="pagination">
                <button class="page-nav-btn" @onclick="PreviousPage" disabled="@(CurrentPage == 1)">
                    Previous
                </button>
                <div class="page-numbers">
                    @for (int i = 1; i <= TotalPages; i++)
                    {
                        @if (i == CurrentPage)
                        {
                            <span class="page-number active">@i</span>
                        }
                        else if (i == 1 || i == TotalPages || (i >= CurrentPage - 1 && i <= CurrentPage + 1))
                        {
                            <button class="page-number" @onclick="() => GoToPage(i)">@i</button>
                        }
                        else if (i == CurrentPage - 2 || i == CurrentPage + 2)
                        {
                            <span class="page-ellipsis">...</span>
                        }
                    }
                </div>
                <button class="page-nav-btn" @onclick="NextPage" disabled="@(CurrentPage == TotalPages)">
                    Next
                </button>
            </div>
        }
    }
</div>

<!-- Delete Confirmation Modal -->
@if (ShowDeleteConfirmation)
{
    <div class="modal-overlay" @onclick="CancelDelete">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3><i class="bi bi-exclamation-triangle"></i> Confirm Delete</h3>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this journal?</p>
            </div>
            <div class="modal-footer">
                <button class="btn-cancel" @onclick="CancelDelete">Cancel</button>
                <button class="btn-delete" @onclick="ConfirmDelete">Delete</button>
            </div>
        </div>
    </div>
}

@code {
    private List<Coursework.Models.JournalEntry> JournalEntries = new List<Coursework.Models.JournalEntry>();
    private bool ShowDeleteConfirmation = false;
    private int EntryIdToDelete = 0;
    
    // Filters
    private string SelectedDateFilter = "";
    private string SelectedMoodFilter = "";
    private string SelectedTagFilter = "";
    private List<Coursework.Models.JournalEntry> FilteredEntries = new List<Coursework.Models.JournalEntry>();
    
    // Pagination
    private int CurrentPage = 1;
    private int PageSize = 3; // 3 entries per page to show pagination clearly
    private int TotalPages => (int)Math.Ceiling((double)FilteredEntries.Count / PageSize);
    private List<Coursework.Models.JournalEntry> PaginatedEntries => 
        FilteredEntries.Skip((CurrentPage - 1) * PageSize).Take(PageSize).ToList();
    
    private List<string> PopularTags => 
        DatabaseService.GetTopTags(10).Keys.ToList();

    protected override void OnInitialized()
    {
        LoadEntries();
    }

    private void LoadEntries()
    {
        JournalEntries = DatabaseService.GetAllJournalEntries();
        ApplyFilters();
    }
    
    private void ApplyFilters()
    {
        var filtered = JournalEntries.AsEnumerable();
        
        // Date filter
        if (!string.IsNullOrEmpty(SelectedDateFilter))
        {
            var now = DateTime.Now.Date;
            filtered = SelectedDateFilter switch
            {
                "today" => filtered.Where(e => e.CreatedAt.Date == now),
                "week" => filtered.Where(e => e.CreatedAt.Date >= now.AddDays(-7)),
                "month" => filtered.Where(e => e.CreatedAt.Date >= now.AddDays(-30)),
                _ => filtered
            };
        }
        
        // Mood filter
        if (!string.IsNullOrEmpty(SelectedMoodFilter))
        {
            filtered = filtered.Where(e => e.PrimaryMood == SelectedMoodFilter);
        }
        
        // Tag filter
        if (!string.IsNullOrEmpty(SelectedTagFilter))
        {
            filtered = filtered.Where(e => 
                !string.IsNullOrEmpty(e.Tags) && 
                e.Tags.Contains(SelectedTagFilter, StringComparison.OrdinalIgnoreCase));
        }
        
        FilteredEntries = filtered.ToList();
        CurrentPage = 1; // Reset to first page when filters change
        StateHasChanged();
    }
    
    private void GoToPage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            CurrentPage = page;
            StateHasChanged();
        }
    }
    
    private void PreviousPage()
    {
        if (CurrentPage > 1)
        {
            CurrentPage--;
            StateHasChanged();
        }
    }
    
    private void NextPage()
    {
        if (CurrentPage < TotalPages)
        {
            CurrentPage++;
            StateHasChanged();
        }
    }

    private string GetPreview(string content)
    {
        if (string.IsNullOrEmpty(content)) return "";
        
        var plainText = System.Text.RegularExpressions.Regex.Replace(content, "<.*?>", " ");
        var preview = plainText.Length > 150 ? plainText.Substring(0, 150) + "..." : plainText;
        return preview;
    }

    private string GetMoodEmoji(string mood)
    {
        return mood.ToLower() switch
        {
            "positive" => "<i class=\"bi bi-emoji-smile\"></i>",
            "neutral" => "<i class=\"bi bi-emoji-neutral\"></i>",
            "negative" => "<i class=\"bi bi-emoji-frown\"></i>",
            _ => "<i class=\"bi bi-journal-text\"></i>"
        };
    }
    
    private string GetMoodEmojiIcon(string mood)
    {
        return mood.ToLower() switch
        {
            "positive" => "<i class=\"bi bi-emoji-smile\" style=\"font-size: 1.5rem;\"></i>",
            "neutral" => "<i class=\"bi bi-emoji-neutral\" style=\"font-size: 1.5rem;\"></i>",
            "negative" => "<i class=\"bi bi-emoji-frown\" style=\"font-size: 1.5rem;\"></i>",
            _ => "<i class=\"bi bi-journal-text\" style=\"font-size: 1.5rem;\"></i>"
        };
    }

    private void EditEntry(int id)
    {
        Navigation.NavigateTo($"/journal?id={id}");
    }

    private void GoToNewJournal()
    {
        Navigation.NavigateTo("/journal");
    }
    
    private void GoToDashboard()
    {
        Navigation.NavigateTo("/dashboard");
    }

    private void ToggleFavorite(int id)
    {
        var entry = DatabaseService.GetJournalEntry(id);
        if (entry != null)
        {
            entry.IsFavorite = !entry.IsFavorite;
            DatabaseService.SaveJournalEntry(entry);
            LoadEntries();
        }
    }

    private void DeleteEntry(int id)
    {
        EntryIdToDelete = id;
        ShowDeleteConfirmation = true;
        StateHasChanged();
    }
    
    private void ConfirmDelete()
    {
        if (EntryIdToDelete > 0)
        {
            DatabaseService.DeleteJournalEntry(EntryIdToDelete);
            ShowDeleteConfirmation = false;
            EntryIdToDelete = 0;
            LoadEntries();
            StateHasChanged();
        }
    }
    
    private void CancelDelete()
    {
        ShowDeleteConfirmation = false;
        EntryIdToDelete = 0;
        StateHasChanged();
    }
}

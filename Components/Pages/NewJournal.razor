@page "/journal"
@implements IDisposable
@inject IJSRuntime JS
@inject Coursework.Services.DatabaseService DatabaseService
@inject NavigationManager Navigation


<div class="page">

    <!-- Header -->
    <header class="topbar">
        <div class="brand">
            <button class="back-btn" @onclick="GoToDashboard" title="Back to Dashboard">
                ← Back
            </button>
            <div class="logo">📕</div>
            <span>My Journal</span>
        </div>

        <div class="header-right">
            <span class="date">@CurrentDate</span>
            <img class="avatar" />
        </div>
    </header>

    <!-- Title -->
    <section class="page-title">
        <div>
            <h1>Today’s Journal</h1>
            <p>Write your thoughts for the day 💗</p>
        </div>
        <span class="status">@StatusMessage</span>
    </section>

    <!-- Content -->
    <main class="layout">

        <!-- Editor -->
        <section class="editor">
            <input class="title-input" placeholder="Title of your entry..." @bind="Title" />

            <div id="editor"></div>

            <div class="editor-footer">
                <span>Words: @WordCount</span>
                <span>Markdown Supported</span>
            </div>
        </section>

        <!-- Sidebar -->
        <aside class="sidebar">

            <!-- Mood -->
            <div class="card">
                <h3>😊 How are you feeling?</h3>

                <p class="label">PRIMARY MOOD *</p>
                <div class="moods">
                    <button type="button" @onclick="@(() => SetPrimaryMood("Positive"))" class="@(PrimaryMood == "Positive" ? "selected" : "")">
                        <span class="emoji">😊</span><span>Positive</span>
                    </button>
                    <button type="button" @onclick="@(() => SetPrimaryMood("Neutral"))" class="@(PrimaryMood == "Neutral" ? "selected" : "")">
                        <span class="emoji">😐</span><span>Neutral</span>
                    </button>
                    <button type="button" @onclick="@(() => SetPrimaryMood("Negative"))" class="@(PrimaryMood == "Negative" ? "selected" : "")">
                        <span class="emoji">😔</span><span>Negative</span>
                    </button>
                </div>

                <p class="label">SECONDARY (MAX 2)</p>
                @if (string.IsNullOrWhiteSpace(PrimaryMood))
                {
                    <small style="color: #999;">Select a primary mood first</small>
                }
                else
                {
                    <div class="chips">
                        @foreach (var mood in GetAvailableSecondaryMoods())
                        {
                            <span class="@(SelectedSecondaryMoods.Contains(mood) ? "selected" : "")" 
                                  @onclick="() => ToggleSecondaryMood(mood)"
                                  style="cursor: pointer;">
                                @mood
                            </span>
                        }
                    </div>
                }
                @if (SelectedSecondaryMoods.Count > 2)
                {
                    <small style="color: #ef4444;">⚠ Maximum 2 secondary moods allowed</small>
                }
            </div>

            <!-- Meta -->
            <div class="card">
                <p class="label">CATEGORY</p>
                <select @bind="Category">
                    <option>Personal Journal</option>
                    <option>Work</option>
                    <option>Travel</option>
                    <option>Health</option>
                    <option>Goals</option>
                </select>

                <p class="label">TAGS</p>
                <div class="tagbox">
                    @foreach (var tag in TagsList)
                    {
                        <span class="tag">
                            #@tag
                            <span style="cursor: pointer; margin-left: 4px;" @onclick="() => RemoveTag(tag)">✕</span>
                        </span>
                    }
                    <input placeholder="Add tag..." 
                           @bind="NewTag" 
                           @bind:event="oninput"
                           @onkeypress="HandleTagKeyPress"
                           @onfocus="HandleTagFocus"
                           @onblur="HandleTagBlur" />
                    @if (ShowTagSuggestions && !string.IsNullOrWhiteSpace(NewTag))
                    {
                        <div class="tag-suggestions">
                            @foreach (var suggestion in GetTagSuggestions())
                            {
                                <span class="tag-suggestion" @onclick="() => AddTagFromSuggestion(suggestion)">
                                    @suggestion
                                </span>
                            }
                        </div>
                    }
                </div>
                <div class="predefined-tags">
                    <small style="color: #999; margin-top: 8px; display: block;">Quick add:</small>
                    @foreach (var tag in PreDefinedTags.Take(10))
                    {
                        <span class="quick-tag" @onclick="() => AddTag(tag)" style="cursor: pointer; margin: 2px; padding: 4px 8px; background: #f0f0f0; border-radius: 4px; font-size: 12px;">@tag</span>
                    }
                </div>

                <div class="meta">
                    <div><span>Created At</span><span>@CreatedAt.ToString("MMM dd, yyyy • hh:mm tt")</span></div>
                    <div><span>Updated At</span><span>@UpdatedAt.ToString("MMM dd, yyyy • hh:mm tt")</span></div>
                </div>
            </div>

            <!-- Actions -->
            <button class="save" @onclick="Save" disabled="@IsSaving"> @(IsSaving ? "Saving..." : "Save Entry")</button>
            @if (CurrentEntryId > 0)
            {
                <div class="actions">
                    <button class="update" @onclick="Update">Update</button>
                    <button class="delete" @onclick="Delete">Delete</button>
                </div>
            }

        </aside>

    </main>
</div>

@code{
    private string HtmlContent = "";
    private string Title = "";
    private string PrimaryMood = "";
    private string Category = "Personal Journal";
    private string Tags = "";
    private List<string> TagsList = new List<string>();
    private string NewTag = "";
    private int CurrentEntryId = 0;
    private bool IsSaving = false;
    private string StatusMessage = "Not saved";
    private DateTime CreatedAt = DateTime.Now;
    private DateTime UpdatedAt = DateTime.Now;
    private int WordCount = 0;
    private bool ShowTagSuggestions = false;
    
    // Secondary moods organized by primary mood category
    private List<string> GetAvailableSecondaryMoods()
    {
        return PrimaryMood.ToLower() switch
        {
            "positive" => new List<string> { "Happy", "Excited", "Relaxed", "Grateful", "Confident" },
            "neutral" => new List<string> { "Calm", "Thoughtful", "Curious", "Nostalgic", "Bored" },
            "negative" => new List<string> { "Sad", "Angry", "Stressed", "Lonely", "Anxious" },
            _ => new List<string>()
        };
    }
    
    private List<string> PreDefinedTags = new List<string>
    {
        "Work", "Career", "Studies", "Family", "Friends", "Relationships",
        "Health", "Fitness", "Personal Growth", "Self-care", "Hobbies", "Travel",
        "Nature", "Finance", "Spirituality", "Birthday", "Holiday", "Vacation",
        "Celebration", "Exercise", "Reading", "Writing", "Cooking", "Meditation",
        "Yoga", "Music", "Shopping", "Parenting", "Projects", "Planning", "Reflection"
    };
    
    private List<string> SelectedSecondaryMoods = new List<string>();
    
    private string CurrentDate => DateTime.Now.ToString("dddd, MMMM dd, yyyy");
    
    private DotNetObjectReference<NewJournal>? objRef;
    [Parameter] public int? Id { get; set; }
    
    protected override void OnInitialized()
    {
        // Parse ID from query string if not provided as route parameter
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = uri.Query;
        
        if (!string.IsNullOrEmpty(query) && query.StartsWith("?"))
        {
            var queryParams = query.Substring(1).Split('&');
            foreach (var param in queryParams)
            {
                var parts = param.Split('=');
                if (parts.Length == 2)
                {
                    var key = parts[0];
                    var value = Uri.UnescapeDataString(parts[1]);
                    
                    if (key == "id")
                    {
                        if (int.TryParse(value, out var entryId))
                        {
                            LoadEntry(entryId);
                            return;
                        }
                    }
                    else if (key == "date")
                    {
                        if (DateTime.TryParse(value, out var date))
                        {
                            CreatedAt = date;
                            UpdatedAt = date;
                        }
                    }
                }
            }
        }
        
        if (Id.HasValue && Id.Value > 0)
        {
            LoadEntry(Id.Value);
        }
    }
    
    private void LoadEntry(int entryId)
    {
        var entry = DatabaseService.GetJournalEntry(entryId);
        if (entry != null)
        {
            CurrentEntryId = entry.Id;
            Title = entry.Title;
            HtmlContent = entry.Content;
            PrimaryMood = entry.PrimaryMood;
            Category = entry.Category;
            Tags = entry.Tags;
            CreatedAt = entry.CreatedAt;
            UpdatedAt = entry.UpdatedAt;
            
            if (!string.IsNullOrEmpty(entry.Tags))
            {
                TagsList = entry.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
            }
            
            if (!string.IsNullOrEmpty(entry.SecondaryMoods))
            {
                SelectedSecondaryMoods = entry.SecondaryMoods.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
            }
        }
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("initQuill", "editor");
                // Set up text change listener for word count
                objRef = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("setupQuillTextChange", objRef);
                
                // Load content if editing existing entry
                if (CurrentEntryId > 0 && !string.IsNullOrEmpty(HtmlContent))
                {
                    await JS.InvokeVoidAsync("setQuillHtml", HtmlContent);
                    UpdateWordCountFromContent();
                }
            }
            catch (JSException ex)
            {
                // Handle JavaScript errors gracefully
                Console.WriteLine($"Error initializing Quill: {ex.Message}");
            }
        }
    }
    
    private void UpdateWordCountFromContent()
    {
        if (string.IsNullOrWhiteSpace(HtmlContent))
        {
            WordCount = 0;
        }
        else
        {
            var plainText = System.Text.RegularExpressions.Regex.Replace(HtmlContent, "<.*?>", " ");
            var words = plainText.Split(new[] { ' ', '\t', '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries);
            WordCount = words.Length;
        }
    }
    
    public void Dispose()
    {
        objRef?.Dispose();
    }
    
    [JSInvokable]
    public void UpdateWordCount(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            WordCount = 0;
        }
        else
        {
            // Remove HTML tags and count words
            var plainText = System.Text.RegularExpressions.Regex.Replace(text, "<.*?>", " ");
            var words = plainText.Split(new[] { ' ', '\t', '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries);
            WordCount = words.Length;
        }
        StateHasChanged();
    }
    
    private void SetPrimaryMood(string mood)
    {
        PrimaryMood = mood;
        // Clear secondary moods when primary mood changes
        SelectedSecondaryMoods.Clear();
        StateHasChanged();
    }
    
    private List<string> GetTagSuggestions()
    {
        if (string.IsNullOrWhiteSpace(NewTag)) return new List<string>();
        
        var searchTerm = NewTag.ToLower();
        return PreDefinedTags
            .Where(t => t.ToLower().Contains(searchTerm) && !TagsList.Contains(t, StringComparer.OrdinalIgnoreCase))
            .Take(5)
            .ToList();
    }
    
    private void AddTagFromSuggestion(string tag)
    {
        AddTag(tag);
        NewTag = "";
        ShowTagSuggestions = false;
    }
    
    private void HandleTagFocus()
    {
        ShowTagSuggestions = true;
        StateHasChanged();
    }
    
    private void HandleTagBlur()
    {
        // Delay hiding to allow click events
        Task.Delay(200).ContinueWith(_ => {
            ShowTagSuggestions = false;
            InvokeAsync(StateHasChanged);
        });
    }
    
    private void ToggleSecondaryMood(string mood)
    {
        if (SelectedSecondaryMoods.Contains(mood))
        {
            SelectedSecondaryMoods.Remove(mood);
        }
        else
        {
            if (SelectedSecondaryMoods.Count < 2)
            {
                SelectedSecondaryMoods.Add(mood);
            }
        }
        StateHasChanged();
    }
    
    private void HandleTagKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(NewTag))
        {
            AddTag(NewTag.Trim());
            NewTag = "";
        }
    }
    
    private void AddTag(string tag)
    {
        var cleanTag = tag.Replace("#", "").Trim();
        if (!string.IsNullOrWhiteSpace(cleanTag) && !TagsList.Contains(cleanTag, StringComparer.OrdinalIgnoreCase))
        {
            TagsList.Add(cleanTag);
            Tags = string.Join(",", TagsList);
            StateHasChanged();
        }
    }
    
    private void RemoveTag(string tag)
    {
        TagsList.Remove(tag);
        Tags = string.Join(",", TagsList);
        StateHasChanged();
    }
    
    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(Title))
        {
            StatusMessage = "⚠ Please enter a title";
            return;
        }
        
        if (string.IsNullOrWhiteSpace(PrimaryMood))
        {
            StatusMessage = "⚠ Please select a primary mood";
            return;
        }
        
        IsSaving = true;
        StatusMessage = "Saving...";
        StateHasChanged();
        
        try
        {
            HtmlContent = await JS.InvokeAsync<string>("getQuillHtml");
            
            // Check if entry already exists for this date (one entry per day rule)
            var entryDate = CreatedAt.Date;
            var existingEntry = DatabaseService.GetJournalEntryByDate(entryDate);
            
            if (existingEntry != null && existingEntry.Id != CurrentEntryId)
            {
                StatusMessage = "⚠ An entry already exists for this date. You can only have one entry per day.";
                IsSaving = false;
                StateHasChanged();
                return;
            }
            
            var entry = new Coursework.Models.JournalEntry
            {
                Id = CurrentEntryId,
                Title = Title,
                Content = HtmlContent,
                PrimaryMood = PrimaryMood,
                SecondaryMoods = string.Join(",", SelectedSecondaryMoods),
                Category = Category,
                Tags = Tags,
                CreatedAt = CreatedAt,
                UpdatedAt = DateTime.Now
            };
            
            var savedEntry = DatabaseService.SaveJournalEntry(entry);
            
            if (savedEntry != null && savedEntry.Id > 0)
            {
                CurrentEntryId = savedEntry.Id;
                UpdatedAt = savedEntry.UpdatedAt;
                CreatedAt = savedEntry.CreatedAt;
                StatusMessage = "✔ Saved successfully";
            }
            else
            {
                StatusMessage = "⚠ Error saving entry";
            }
        }
        catch (JSException ex)
        {
            StatusMessage = "⚠ Error: " + ex.Message;
            Console.WriteLine($"Error getting Quill content: {ex.Message}");
        }
        catch (Exception ex)
        {
            StatusMessage = "⚠ Error: " + ex.Message;
            Console.WriteLine($"Error saving entry: {ex.Message}");
        }
        finally
        {
            IsSaving = false;
            StateHasChanged();
        }
    }
    
    private async Task Update()
    {
        if (CurrentEntryId > 0)
        {
            await Save();
        }
    }
    
    private void Delete()
    {
        if (CurrentEntryId > 0)
        {
            DatabaseService.DeleteJournalEntry(CurrentEntryId);
            Navigation.NavigateTo("/dashboard");
        }
    }
    
    private void ResetForm()
    {
        CurrentEntryId = 0;
        Title = "";
        HtmlContent = "";
        PrimaryMood = "";
        Category = "Personal Journal";
        Tags = "";
        TagsList.Clear();
        SelectedSecondaryMoods.Clear();
        WordCount = 0;
        CreatedAt = DateTime.Now;
        UpdatedAt = DateTime.Now;
    }
   
    private void GoToDashboard()
    {
        Navigation.NavigateTo("/dashboard");
    }
}
@page "/register"
@inject NavigationManager Navigation
@inject Coursework.Services.DatabaseService DatabaseService
@inject Coursework.Services.AuthenticationService AuthService

<div class="register-page">

    <!-- Top Navigation -->
    <div class="top-bar">
        <div class="brand">
            <span class="brand-icon">📓</span>
            <span class="brand-text">My Journal</span>
        </div>
    </div>

    <!-- Register Card -->
    <div class="register-card">
        <h2>Register</h2>
        <p class="subtitle">Create your account to start journaling 💗</p>

        <div class="form-group">
            <label for="username">Username</label>
            <input id="username" type="text" placeholder="Choose a username" @bind="Username" />
        </div>

        <div class="form-group">
            <label for="email">Email Address</label>
            <input id="email" type="email" placeholder="name@example.com" @bind="Email" />
        </div>

        <div class="form-group">
            <label for="password">Password</label>
            <input id="password" type="password" placeholder="Create a password" @bind="Password" />
        </div>

        <div class="form-group">
            <label for="confirmPassword">Confirm Password</label>
            <input id="confirmPassword" type="password" placeholder="Retype your password" @bind="ConfirmPassword" />
        </div>

        <div class="terms">
            <input type="checkbox" id="terms" @bind="AgreedToTerms" />

            <label for="terms">
                I agree with the
                <a href="#">Terms & Conditions</a>
            </label>
        </div>
        
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="error-message">@ErrorMessage</div>
        }
        
        <button class="register-btn" @onclick="HandleRegister" disabled="@IsRegistering">
            @(IsRegistering ? "Registering..." : "Register")
        </button>
        <p class="login-text">
            Already have an account?
            <NavLink href="/" class="login-link">
                Login
            </NavLink>

        </p>
    </div>
</div>
@code {
    private string Username = "";
    private string Email = "";
    private string Password = "";
    private string ConfirmPassword = "";
    private bool AgreedToTerms = false;
    private bool IsRegistering = false;
    private string ErrorMessage = "";
    
    private string HashPassword(string password)
    {
        using (var sha256 = System.Security.Cryptography.SHA256.Create())
        {
            var bytes = System.Text.Encoding.UTF8.GetBytes(password);
            var hash = sha256.ComputeHash(bytes);
            return Convert.ToBase64String(hash);
        }
    }

    private void HandleRegister()
    {
        ErrorMessage = "";

        if (string.IsNullOrWhiteSpace(Username) || string.IsNullOrWhiteSpace(Email) || 
            string.IsNullOrWhiteSpace(Password) || string.IsNullOrWhiteSpace(ConfirmPassword))
        {
            ErrorMessage = "Please fill in all fields";
            return;
        }

        if (Password != ConfirmPassword)
        {
            ErrorMessage = "Passwords do not match";
            return;
        }

        if (Password.Length < 6)
        {
            ErrorMessage = "Password must be at least 6 characters";
            return;
        }

        if (!AgreedToTerms)
        {
            ErrorMessage = "Please agree to the Terms & Conditions";
            return;
        }

        IsRegistering = true;

        try
        {
            // Check if username already exists
            if (DatabaseService.GetUserByUsername(Username) != null)
            {
                ErrorMessage = "Username already exists";
                IsRegistering = false;
                return;
            }

            // Check if email already exists
            if (DatabaseService.GetUserByEmail(Email) != null)
            {
                ErrorMessage = "Email already registered";
                IsRegistering = false;
                return;
            }

            // Hash password using SHA256 (deterministic)
            var passwordHash = HashPassword(Password);
            var user = new Coursework.Models.User
            {
                Username = Username,
                Email = Email,
                PasswordHash = passwordHash
            };

            DatabaseService.SaveUser(user);
            var savedUser = DatabaseService.GetUserByUsername(Username);
            if (savedUser != null)
            {
                AuthService.Login(savedUser);
            }
            Navigation.NavigateTo("/dashboard");
        }
        catch (Exception ex)
        {
            ErrorMessage = "An error occurred: " + ex.Message;
        }
        finally
        {
            IsRegistering = false;
        }
    }
}